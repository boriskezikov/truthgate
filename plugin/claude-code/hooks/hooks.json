{
  "description": "TruthGate: a snapshot of the working directory when a prompt is sent, and an audit of the report when Claude stops",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/plugin/claude-code/scripts/run.sh",
            "timeout": 25
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/plugin/claude-code/scripts/run.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
